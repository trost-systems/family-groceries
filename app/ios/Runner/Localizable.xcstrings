{
  "sourceLanguage": "en",
  "strings": {
    "Add to Hummlist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Hummlist hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Hummlist"
          }
        }
      }
    },
    "Adds items to your household's Hummlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Einträge zur Hummlist deines Haushalts hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds items to your household's Hummlist."
          }
        }
      }
    },
    "Item": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintrag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Item"
          }
        }
      }
    },
    "Items": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items"
          }
        }
      }
    },
    "Read my Hummlist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Hummlist vorlesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read my Hummlist"
          }
        }
      }
    },
    "Reads the open items on your household's Hummlist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die offenen Einträge der Hummlist deines Haushalts vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the open items on your household's Hummlist."
          }
        }
      }
    },
    "siri.add.notConfirmed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann nicht bestätigen, dass etwas hinzugefügt wurde. Schau bitte auf der Liste nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't confirm that anything was added. Please check the list."
          }
        }
      }
    },
    "siri.add.nothingAdded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe nichts hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't add anything."
          }
        }
      }
    },
    "siri.ask.items": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll auf die Liste?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I add?"
          }
        }
      }
    },
    "siri.failure.noAnswer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hummlist hat nicht rechtzeitig geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hummlist didn't answer in time."
          }
        }
      }
    },
    "siri.failure.noHousehold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Hummlist und richte zuerst deinen Haushalt ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hummlist and set up your household first."
          }
        }
      }
    },
    "siri.failure.notSignedIn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Hummlist und melde dich an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hummlist and sign in first."
          }
        }
      }
    },
    "siri.failure.nothingUnderstood": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe keine Einträge verstanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't catch any items."
          }
        }
      }
    },
    "siri.failure.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hummlist hat gerade keine Internetverbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hummlist can't reach the internet right now."
          }
        }
      }
    },
    "siri.failure.server": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Hummlist ist etwas schiefgelaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong at Hummlist."
          }
        }
      }
    },
    "siri.failure.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Hummlist und melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hummlist and sign in again."
          }
        }
      }
    },
    "siri.failure.tooLong": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war zu viel auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was too much at once."
          }
        }
      }
    },
    "siri.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachbefehle sind Teil von Hummlist Premium. Du kannst es in der App freischalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice commands are part of Hummlist Premium. You can unlock it in the app under More, Hummlist Premium."
          }
        }
      }
    },
    "siri.read.notRead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte deine Liste nicht vorlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't read your list."
          }
        }
      }
    }
  },
  "version": "1.0"
}
