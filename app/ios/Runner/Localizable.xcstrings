{
  "sourceLanguage": "en",
  "strings": {
    "Add to Snacklist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Snacklist hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Snacklist"
          }
        }
      }
    },
    "Adds items to your household's Snacklist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Einträge zur Snacklist deines Haushalts hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds items to your household's Snacklist."
          }
        }
      }
    },
    "Item": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintrag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Item"
          }
        }
      }
    },
    "Items": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items"
          }
        }
      }
    },
    "List": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List"
          }
        }
      }
    },
    "Open Snacklist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacklist öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Snacklist"
          }
        }
      }
    },
    "Opens your household's Snacklist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Snacklist deines Haushalts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your household's Snacklist."
          }
        }
      }
    },
    "Read my Snacklist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Snacklist vorlesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read my Snacklist"
          }
        }
      }
    },
    "Reads the open items on your household's Snacklist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die offenen Einträge der Snacklist deines Haushalts vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the open items on your household's Snacklist."
          }
        }
      }
    },
    "siri.add.notConfirmed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann nicht bestätigen, dass etwas hinzugefügt wurde. Schau bitte auf der Liste nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't confirm that anything was added. Please check the list."
          }
        }
      }
    },
    "siri.add.nothingAdded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe nichts hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't add anything."
          }
        }
      }
    },
    "siri.ask.items": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll auf die Liste?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I add?"
          }
        }
      }
    },
    "siri.failure.noAnswer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacklist hat nicht rechtzeitig geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacklist didn't answer in time."
          }
        }
      }
    },
    "siri.failure.noHousehold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Snacklist und richte zuerst deinen Haushalt ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Snacklist and set up your household first."
          }
        }
      }
    },
    "siri.failure.notSignedIn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Snacklist und melde dich an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Snacklist and sign in first."
          }
        }
      }
    },
    "siri.failure.nothingUnderstood": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe keine Einträge verstanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't catch any items."
          }
        }
      }
    },
    "siri.failure.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacklist hat gerade keine Internetverbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snacklist can't reach the internet right now."
          }
        }
      }
    },
    "siri.failure.server": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Snacklist ist etwas schiefgelaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong at Snacklist."
          }
        }
      }
    },
    "siri.failure.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Snacklist und melde dich erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Snacklist and sign in again."
          }
        }
      }
    },
    "siri.failure.tooLong": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war zu viel auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was too much at once."
          }
        }
      }
    },
    "siri.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachbefehle sind Teil von Snacklist Premium. Du kannst es in der App freischalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice commands are part of Snacklist Premium. You can unlock it in the app under More, Snacklist Premium."
          }
        }
      }
    },
    "siri.read.notRead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte deine Liste nicht vorlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't read your list."
          }
        }
      }
    }
  },
  "version": "1.0"
}
