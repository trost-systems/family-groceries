# frozen_string_literal: true

# Release lanes. docs/RELEASE.md describes the inputs and the workflow that
# runs them (.github/workflows/release.yml).
#
#   bundle exec fastlane ios certificates      once: create the App Store
#                                              certificate and profile in the
#                                              match repo
#   bundle exec fastlane ios preflight         profile check, newest TestFlight
#                                              builds as JSON
#   bundle exec fastlane ios renew_profile     new App Store profile after a
#                                              capability change
#   bundle exec fastlane ios beta              build the IPA; upload it to
#                                              TestFlight, or only validate it
#   bundle exec fastlane ios wait_processing   set What to Test, wait for VALID
#   bundle exec fastlane android build         build the signed AAB
#   bundle exec fastlane android play_access   can the service account reach
#                                              the Play app?
#   bundle exec fastlane android internal      upload the AAB to the internal
#                                              track, or only validate it

opt_out_usage

require "json"
require "plist"
require "shellwords"

APP_ID = "com.hummlist.app"
# fastlane runs lane code inside fastlane/ and actions in app/, so paths are
# absolute.
APP_DIR = File.expand_path("..", __dir__)
AAB = File.join(APP_DIR, "build/app/outputs/bundle/release/app-release.aab")

def build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

# RELEASE_UPLOAD=false builds, signs and validates without publishing.
def upload?
  ENV.fetch("RELEASE_UPLOAD", "false") == "true"
end

def flutter(*args)
  sh("cd #{APP_DIR.shellescape} && flutter #{args.shelljoin}")
end

platform :ios do
  def asc_api_key
    key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      in_house: false
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: key)
    key
  end

  def asc_app
    Spaceship::ConnectAPI::App.find(APP_ID) || UI.user_error!("no App Store Connect app for #{APP_ID}")
  end

  desc "Create or renew the App Store certificate and profile in the match repo"
  lane :certificates do
    match(readonly: false, api_key: asc_api_key)
  end

  # The Release plan job runs this first. A build number must exceed every
  # earlier one, and an unchanged main still ships when no build is installable
  # (TestFlight expired them). Enabling a capability on the App ID invalidates
  # the App Store profile; that fails here, before an hour of macOS build.
  desc "Check the App Store profile; write TestFlight's highest build and whether one is installable to TESTFLIGHT_JSON"
  lane :preflight do
    asc_api_key
    profile_name = "match AppStore #{APP_ID}"
    # A regenerated profile can leave an INVALID one of the same name behind.
    states = Spaceship::ConnectAPI::Profile.all(filter: { name: profile_name }).map(&:profile_state)
    unless states.include?("ACTIVE")
      UI.user_error!("Profile '#{profile_name}' is #{states.empty? ? 'missing' : states.join(', ')}: run `bundle exec fastlane ios renew_profile` (docs/RELEASE.md, Capabilities)")
    end
    builds = Spaceship::ConnectAPI::Build.all(app_id: asc_app.id, sort: "-uploadedDate", limit: 50)
    state = {
      max_build: builds.map { |b| b.version.to_i }.max || 0,
      installable: builds.any? { |b| b.processing_state == "VALID" && !b.expired }
    }
    File.write(ENV.fetch("TESTFLIGHT_JSON"), JSON.generate(state))
    UI.message("TestFlight: #{state}")
  end

  # After a capability change on the App ID: a new App Store profile signed by
  # the existing certificate, pushed to the match repo. match creates a
  # certificate only when the repo holds none, and certificate_id pins the one
  # it has, so this never creates or revokes a certificate.
  desc "Regenerate the App Store profile in the match repo with the existing certificate"
  lane :renew_profile do
    match(
      readonly: false,
      force: ENV.fetch("MATCH_FORCE", "true") == "true",
      certificate_id: ENV.fetch("MATCH_CERTIFICATE_ID", "GN85KDC962"),
      renew_expired_certs: false,
      api_key: asc_api_key,
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )
  end

  desc "Build the release IPA; upload it to TestFlight (RELEASE_UPLOAD=true) or validate it"
  lane :beta do
    api_key = asc_api_key
    team_id = ENV.fetch("APPLE_TEAM_ID")
    setup_ci if ENV["CI"]
    match(readonly: true, api_key: api_key, team_id: team_id)
    profile = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")

    # The project keeps automatic signing for local development; the release
    # build signs manually with what match installed.
    update_code_signing_settings(
      path: File.join(APP_DIR, "ios/Runner.xcodeproj"),
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: profile,
      targets: ["Runner"]
    )

    export_options = File.join(APP_DIR, "build/ios/ExportOptions.plist")
    FileUtils.mkdir_p(File.dirname(export_options))
    File.write(export_options, {
      "method" => "app-store-connect",
      "destination" => "export",
      "signingStyle" => "manual",
      "teamID" => team_id,
      "signingCertificate" => "Apple Distribution",
      "provisioningProfiles" => { APP_ID => profile },
      "uploadSymbols" => true,
      "manageAppVersionAndBuildNumber" => false
    }.to_plist)

    flutter("build", "ipa", "--release", "--build-number=#{build_number}",
            "--dart-define-from-file=config/auth.json",
            "--export-options-plist=#{export_options}")

    ipa = Dir.glob(File.join(APP_DIR, "build/ios/ipa/*.ipa")).first
    UI.user_error!("no IPA under build/ios/ipa") if ipa.nil?
    upload? ? upload_ipa(api_key, ipa) : validate_ipa(ipa)
  end

  # Internal testers only: no external distribution, no Beta App Review. The
  # group "Familie" has access to all builds, so a VALID build reaches it
  # without a distribute step. Export compliance is answered by Info.plist.
  def upload_ipa(api_key, ipa)
    attempts = 0
    begin
      attempts += 1
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa,
        app_identifier: APP_ID,
        distribute_external: false,
        skip_submission: true,
        # fastlane then logs "no changelog supplied": wait_processing sets
        # What to Test once the build shows up in App Store Connect.
        skip_waiting_for_build_processing: true
      )
    rescue StandardError => e
      raise if attempts > 1
      # An Apple outage gets one more try. If the first attempt reached ASC
      # after all, a second upload of the same number would be rejected, so
      # look for the build for 10 minutes first.
      UI.important("Upload failed (#{e.message}); checking App Store Connect before one more try")
      20.times do
        sleep(30)
        if Spaceship::ConnectAPI::Build.all(app_id: asc_app.id, build_number: build_number, limit: 1).any?
          UI.message("Build #{build_number} reached App Store Connect after all")
          return
        end
      end
      retry
    end
  end

  # altool looks for the key in ~/.appstoreconnect/private_keys.
  def validate_ipa(ipa)
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    dir = File.expand_path("~/.appstoreconnect/private_keys")
    key_file = File.join(dir, "AuthKey_#{key_id}.p8")
    FileUtils.mkdir_p(dir)
    File.write(key_file, ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"), perm: 0o600)
    begin
      sh("xcrun", "altool", "--validate-app", "--file", ipa, "--type", "ios",
         "--apiKey", key_id, "--apiIssuer", ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"))
    ensure
      File.delete(key_file)
    end
    UI.success("App Store Connect validated #{File.basename(ipa)} (#{build_number}); nothing was uploaded")
  end

  # Sets What to Test (RELEASE_NOTES_DE/_EN) as soon as the build shows up,
  # then waits until Apple has processed it. A build that ends INVALID or
  # FAILED, is still processing after WAIT_MINUTES, or comes out already
  # expired fails the run, which opens the "Weekly release failed" issue.
  desc "Set What to Test on BUILD_NUMBER and wait until TestFlight processed it"
  lane :wait_processing do
    asc_api_key
    app = asc_app
    deadline = Time.now + (ENV.fetch("WAIT_MINUTES", "45").to_i * 60)
    notes = { "de-DE" => ENV.fetch("RELEASE_NOTES_DE"), "en-US" => ENV.fetch("RELEASE_NOTES_EN") }
    notes_set = false
    errors = 0
    loop do
      begin
        build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: build_number, limit: 1).first
        errors = 0
      rescue StandardError => e
        # One failed request is retried; two in a row are an outage.
        errors += 1
        UI.user_error!("App Store Connect API failed twice in a row: #{e.message}") if errors > 1
        UI.important("App Store Connect API failed (#{e.message}); retrying")
        sleep(60)
        next
      end

      if build && !notes_set
        set_whats_new(build, notes)
        notes_set = true
      end
      state = build&.processing_state
      UI.message("Build #{build_number}: #{state || 'not in App Store Connect yet'}")
      case state
      when "VALID"
        if build.expired
          UI.user_error!("Build #{build_number} is VALID but already expired (docs/RELEASE.md, TestFlight builds expired)")
        end
        UI.success("Build #{build_number} is VALID and available to the internal group")
        break
      when "INVALID", "FAILED"
        UI.user_error!("Build #{build_number} processing ended #{state}; Apple's email to the account holder names the reason")
      end
      UI.user_error!("Build #{build_number} is still #{state || 'missing'} after the wait") if Time.now > deadline
      sleep(30)
    end
  end

  # Notes are a courtesy: a refusal warns instead of failing a build that
  # reached the testers. pilot's sanitizer drops what Apple rejects (emoji,
  # "<") and cuts to 4000 bytes.
  def set_whats_new(build, notes)
    require "pilot"
    existing = Spaceship::ConnectAPI.get_beta_build_localizations(filter: { build: build.id }).to_models
    notes.each do |locale, text|
      attributes = { whatsNew: Pilot::BuildManager.sanitize_changelog(text) }
      localization = existing.find { |l| l.locale == locale }
      if localization
        Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: localization.id, attributes: attributes)
      else
        Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: attributes.merge(locale: locale))
      end
    end
    UI.success("What to Test set for #{notes.keys.join(', ')}")
  rescue StandardError => e
    UI.important("Could not set What to Test: #{e.message}")
  end
end

platform :android do
  desc "Build the release App Bundle (signed with android/key.properties)"
  lane :build do
    flutter("build", "appbundle", "--release", "--build-number=#{build_number}",
            "--dart-define-from-file=config/auth.json")
  end

  # Credentials come from Workload Identity Federation: google-github-actions/auth
  # writes an external_account file and points GOOGLE_APPLICATION_CREDENTIALS at it.
  def play_json_key
    ENV.fetch("GOOGLE_APPLICATION_CREDENTIALS") { UI.user_error!("no Google credentials (GOOGLE_APPLICATION_CREDENTIALS)") }
  end

  # Writes "ok" or the Play API's refusal to PLAY_ACCESS_FILE. A failed token
  # exchange (Workload Identity Federation, IAM) fails the lane instead: that is
  # this repo's setup, not the Play app's.
  desc "Check that the service account can open an edit on the Play app"
  lane :play_access do
    require "supply"
    config = FastlaneCore::Configuration.create(Supply::Options.available_options,
                                                { json_key: play_json_key, package_name: APP_ID })
    client = Supply::Client.make_from_config(params: config)
    UI.success("Got a Google access token for the service account")
    result = begin
      client.begin_edit(package_name: APP_ID)
      client.abort_current_edit
      "ok"
    rescue FastlaneCore::Interface::FastlaneError => e
      e.message.lines.first.strip
    end
    UI.message("Play access for #{APP_ID}: #{result}")
    File.write(ENV.fetch("PLAY_ACCESS_FILE"), result)
  end

  desc "Upload the AAB to the Play internal track (RELEASE_UPLOAD=true) or validate it"
  lane :internal do
    upload_to_play_store(
      package_name: APP_ID,
      json_key: play_json_key,
      track: "internal",
      # Play accepts only draft releases until the app has been published once.
      release_status: ENV.fetch("PLAY_RELEASE_STATUS"),
      aab: AAB,
      validate_only: !upload?,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
