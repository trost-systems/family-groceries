            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "night": {
      "$value": [
        {
          "color": "#d9b23a",
          "offsetX": {
            "value": 5,
            "unit": "px"
          },
          "offsetY": {
            "value": 5,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "night-l": {
      "$value": [
        {
          "color": "#d9b23a",
          "offsetX": {
            "value": 10,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 0.98,
        "letterSpacing": {
          "value": -0.035,
          "unit": "em"
        }
      }
    },
    "headline-l": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 2.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 1.02,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 1.08,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body-l": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1.1875,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1.0625,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.25,
        "letterSpacing": {
          "value": 0.005,
          "unit": "em"
        }
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0.14,
          "unit": "em"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "s": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "m": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "l": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "depth": {
    "$type": "dimension",
    "edge": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "edge-l": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lift": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "press": {
      "$value": "{depth.edge}"
    }
  },
  "$extensions": {
    "com.hummlist": {
      "contrastPairs": [
        [
          "brand",
          "honey-soft",
          4.5
        ],
        [
          "text",
          "success-soft",
          4.5
        ],
        [
          "text",
          "accent-soft",
          4.5
        ],
        [
          "text-muted",
          "surface-sunken",
          4.5
        ]
      ]
    }
  }
}
