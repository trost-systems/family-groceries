{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Space Grotesk",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/space-grotesk 5.3.0 (floriankarsten/space-grotesk)",
            "files": "fonts/space-grotesk-latin-wght-normal.woff2",
            "weight": "300 700",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "IBM Plex Sans",
          "system-ui",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/ibm-plex-sans 5.3.0 (IBM/plex)",
            "files": "fonts/ibm-plex-sans-latin-wght-normal.woff2",
            "weight": "100 700",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 600
      },
      "heavy": {
        "$value": 700
      }
    }
  },
  "color": {
    "light": {
      "$type": "color",
      "brand": {
        "$value": "#2852b8",
        "$description": "Riso-Blau mittel: Mengen, Zahlen, Linien auf Papier"
      },
      "on-brand": {
        "$value": "#fbf8f1"
      },
      "honey": {
        "$value": "#ffd23f",
        "$description": "Riso-Gelb: die zweite Druckfarbe, Fläche für Knöpfe, Bänder, Marke"
      },
      "on-honey": {
        "$value": "#1e3a8c"
      },
      "honey-soft": {
        "$value": "#f6e3a0",
        "$description": "Gelb im Halbton: Chips und neue Einträge"
      },
      "accent": {
        "$value": "#2852b8",
        "$description": "Riso-Blau: Links, Stimme, Fokusring"
      },
      "on-accent": {
        "$value": "#fbf8f1"
      },
      "accent-soft": {
        "$value": "#d3def4",
        "$description": "Blau im Halbton: weiche Fläche"
      },
      "surface": {
        "$value": "#f3eee2",
        "$description": "Ungestrichenes Papier mit Korn"
      },
      "surface-raised": {
        "$value": "#fbf8f1",
        "$description": "Helleres Papier: Karten, Eingabefeld"
      },
      "surface-sunken": {
        "$value": "#e9e1cc",
        "$description": "Dunkleres Papier: Mulden, Fußzeile"
      },
      "text": {
        "$value": "#1e3a8c",
        "$description": "Federal Blue: alle Schrift ist blaue Druckfarbe"
      },
      "text-muted": {
        "$value": "#3a4f8f",
        "$description": "Blau, dünner aufgetragen"
      },
      "border": {
        "$value": "#1e3a8c",
        "$description": "Blaue 2-px-Kontur"
      },
      "divider": {
        "$value": "#d8cdb0",
        "$description": "Haarlinien (dekorativ)"
      },
      "ink": {
        "$value": "#1e3a8c",
        "$description": "Kontur auf Gelb, Rahmen des Telefons"
      },
      "success": {
        "$value": "#2b7a3e",
        "$description": "Überdruck-Grün: Gelb auf Blau, für abgehakt"
      },
      "on-success": {
        "$value": "#fbf8f1"
      },
      "success-soft": {
        "$value": "#d7e7b8",
        "$description": "Grün im Halbton"
      },
      "warning": {
        "$value": "#a34700"
      },
      "on-warning": {
        "$value": "#fbf8f1"
      },
      "error": {
        "$value": "#c0262d"
      },
      "on-error": {
        "$value": "#fbf8f1"
      },
      "edge": {
        "$value": "#1e3a8c",
        "$description": "Die Kante unter Knöpfen: blaue Druckfarbe"
      },
      "honey-edge": {
        "$value": "#7f9d3a",
        "$description": "Wand eines gelben Knopfs: Gelb über Blau wird Grün"
      },
      "surface-edge": {
        "$value": "#b8c6e6",
        "$description": "Wand eines hellen Knopfs: Blau im Halbton"
      }
    },
    "dark": {
      "$type": "color",
      "brand": {
        "$value": "#ffd23f",
        "$description": "Gelbe Druckfarbe auf dunklem Karton"
      },
      "on-brand": {
        "$value": "#131a33"
      },
      "honey": {
        "$value": "#ffd23f",
        "$description": "Riso-Gelb, deckend auf Nachtblau"
      },
      "on-honey": {
        "$value": "#131a33"
      },
      "honey-soft": {
        "$value": "#3d3a26",
        "$description": "Gelb im Halbton auf Karton"
      },
      "accent": {
        "$value": "#93b2ff",
        "$description": "Hellblaue Druckfarbe"
      },
      "on-accent": {
        "$value": "#131a33"
      },
      "accent-soft": {
        "$value": "#283a6e",
        "$description": "Hellblau im Halbton"
      },
      "surface": {
        "$value": "#131a33",
        "$description": "Nachtblauer Karton mit Korn"
      },
      "surface-raised": {
        "$value": "#1b2445",
        "$description": "Karten"
      },
      "surface-sunken": {
        "$value": "#0d1328",
        "$description": "Mulden, Fußzeile"
      },
      "text": {
        "$value": "#e3eaff",
        "$description": "Hellblaue Schrift"
      },
      "text-muted": {
        "$value": "#a8b8e2"
      },
      "border": {
        "$value": "#7f95d0",
        "$description": "Hellblaue Kontur, gedämpft"
      },
      "divider": {
        "$value": "#2a3560"
      },
      "ink": {
        "$value": "#070b1a",
        "$description": "Schwarzer Karton unter Knöpfen"
      },
      "success": {
        "$value": "#9bd67f",
        "$description": "Überdruck-Grün, hell"
      },
      "on-success": {
        "$value": "#131a33"
      },
      "success-soft": {
        "$value": "#22402e"
      },
      "warning": {
        "$value": "#ffb067"
      },
      "on-warning": {
        "$value": "#131a33"
      },
      "error": {
        "$value": "#ff8f88"
      },
      "on-error": {
        "$value": "#131a33"
      },
      "edge": {
        "$value": "#070b1a"
      },
      "honey-edge": {
        "$value": "#8fae3f",
        "$description": "Gelb auf Blau, hell gedruckt"
      },
      "surface-edge": {
        "$value": "#2c3d73"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sticker-s": {
      "$value": [
        {
          "color": "#ffd23f",
          "offsetX": {
