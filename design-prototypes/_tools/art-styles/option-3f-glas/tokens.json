{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Outfit",
          "system-ui",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/outfit 5.3.0 (Outfitio/Outfit-Fonts)",
            "files": "fonts/outfit-latin-wght-normal.woff2",
            "weight": "100 900",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "Figtree",
          "system-ui",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/figtree 5.3.0 (erikdkennedy/figtree)",
            "files": "fonts/figtree-latin-wght-normal.woff2",
            "weight": "300 900",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 450
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 650
      },
      "heavy": {
        "$value": 700
      }
    }
  },
  "color": {
    "light": {
      "$type": "color",
      "brand": {
        "$value": "#8a5800",
        "$description": "Honig dunkel: Honig als Schrift und Linie auf Glas"
      },
      "on-brand": {
        "$value": "#ffffff"
      },
      "honey": {
        "$value": "#ffc233",
        "$description": "Honig: die Füllung der Knöpfe und Kerne, immer mit Tinte darauf"
      },
      "on-honey": {
        "$value": "#17141f"
      },
      "honey-soft": {
        "$value": "#ffe9ad",
        "$description": "Pollen: getöntes Glas für neue Einträge und Vorschläge"
      },
      "accent": {
        "$value": "#5b3cc4",
        "$description": "Violett: Links, Stimme und Fokusring"
      },
      "on-accent": {
        "$value": "#ffffff"
      },
      "accent-soft": {
        "$value": "#e7e0ff",
        "$description": "Lavendelglas: Sprechblasen und Avatare"
      },
      "surface": {
        "$value": "#f5f3f7",
        "$description": "Perlgrund: der ruhige Seitengrund unter den Lichtern"
      },
      "surface-raised": {
        "$value": "#ffffff",
        "$description": "Glas: Karten, Sticker und Telefon, durchscheinend gesetzt"
      },
      "surface-sunken": {
        "$value": "#ebe8f1",
        "$description": "Mulden und Code"
      },
      "text": {
        "$value": "#17141f",
        "$description": "Tinte: kühles Fast-Schwarz"
      },
      "text-muted": {
        "$value": "#4d475c",
        "$description": "Zweite Zeile, Erklärungen"
      },
      "border": {
        "$value": "#6a6382",
        "$description": "Linie um Häkchen-Waben und Eingaben, mindestens 3 : 1"
      },
      "divider": {
        "$value": "#e0dbe8",
        "$description": "Haarlinien zwischen Zeilen (dekorativ)"
      },
      "ink": {
        "$value": "#17141f",
        "$description": "Tiefe Tinte für Schatten"
      },
      "success": {
        "$value": "#1f7a3d",
        "$description": "Blatt: abgehakt und synchron"
      },
      "on-success": {
        "$value": "#ffffff"
      },
      "success-soft": {
        "$value": "#d3f1dc"
      },
      "warning": {
        "$value": "#a34700"
      },
      "on-warning": {
        "$value": "#ffffff"
      },
      "error": {
        "$value": "#c0262d"
      },
      "on-error": {
        "$value": "#ffffff"
      },
      "edge": {
        "$value": "#a86b00",
        "$description": "Untere Kante des Honig-Knopfs, die Dicke des Glases"
      },
      "honey-edge": {
        "$value": "#e3a312",
        "$description": "Seitenwand des Honig-Knopfs"
      },
      "surface-edge": {
        "$value": "#d6d0e2",
        "$description": "Seitenwand eines hellen Glasknopfs"
      },
      "glow-honey": {
        "$value": "#ffc233",
        "$description": "Honiglicht hinter dem Glas, nur als weicher Verlauf"
      },
      "glow-violet": {
        "$value": "#a38bff",
        "$description": "Violettes Licht hinter dem Glas"
      },
      "glow-mint": {
        "$value": "#7fdcbc",
        "$description": "Minzlicht, sparsam"
      }
    },
    "dark": {
      "$type": "color",
      "brand": {
        "$value": "#ffc94d"
      },
      "on-brand": {
        "$value": "#14111d"
      },
      "honey": {
        "$value": "#ffc233"
      },
      "on-honey": {
        "$value": "#14111d"
      },
      "honey-soft": {
        "$value": "#3a2d10"
      },
      "accent": {
        "$value": "#c3b2ff"
      },
      "on-accent": {
        "$value": "#14111d"
      },
      "accent-soft": {
        "$value": "#2c2452"
      },
      "surface": {
        "$value": "#0c0a14"
      },
      "surface-raised": {
        "$value": "#1b1729"
      },
      "surface-sunken": {
        "$value": "#08070e"
      },
      "text": {
        "$value": "#f7f4ff"
      },
      "text-muted": {
        "$value": "#c2bbd6"
      },
      "border": {
        "$value": "#8a83a3"
      },
      "divider": {
        "$value": "#2a2540"
      },
      "ink": {
        "$value": "#000000"
      },
      "success": {
        "$value": "#7ddc94"
      },
      "on-success": {
        "$value": "#14111d"
      },
      "success-soft": {
        "$value": "#173823"
      },
      "warning": {
        "$value": "#ffb067"
      },
      "on-warning": {
        "$value": "#14111d"
      },
      "error": {
        "$value": "#ff8f88"
      },
      "on-error": {
        "$value": "#14111d"
      },
      "edge": {
        "$value": "#6e4a00"
      },
      "honey-edge": {
        "$value": "#c48a00"
      },
      "surface-edge": {
        "$value": "#2e2945"
      },
      "glow-honey": {
        "$value": "#ffa726"
      },
      "glow-violet": {
        "$value": "#7c5cff"
      },
      "glow-mint": {
        "$value": "#3fd6a8"
      }
    }
  },
  "$extensions": {
    "com.hummlist": {
      "contrastPairs": [
        [
          "accent",
          "accent-soft",
          4.5
        ],
        [
          "text-muted",
          "honey-soft",
          4.5
        ],
        [
          "text",
          "accent-soft",
          4.5
        ]
      ]
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 3.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.02,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "headline-l": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 2.625,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.06,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "headline": {
