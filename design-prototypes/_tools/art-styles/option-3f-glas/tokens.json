        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 650,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    }
