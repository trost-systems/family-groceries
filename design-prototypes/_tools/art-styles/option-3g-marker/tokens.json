  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 4.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 0.95,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      },
      "$description": "Hero headline (desktop), handwritten; mobile steps down to headline-l"
    },
    "headline-l": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 3.375,
          "unit": "rem"
