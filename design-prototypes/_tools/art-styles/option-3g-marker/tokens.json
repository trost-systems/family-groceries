{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Caveat",
          "Comic Sans MS",
          "cursive"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/caveat 5.3.0 (googlefonts/caveat)",
            "files": "fonts/caveat-latin-wght-normal.woff2",
            "weight": "400 700",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "Nunito",
          "ui-rounded",
          "Arial Rounded MT Bold",
          "system-ui",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/nunito 5.3.0 (googlefonts/nunito)",
            "files": "fonts/nunito-latin-wght-normal.woff2",
            "weight": "200 1000",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    }
  }
}