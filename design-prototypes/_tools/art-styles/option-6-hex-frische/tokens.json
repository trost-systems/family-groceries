  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Bricolage Grotesque",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/bricolage-grotesque 5.3.0 (ateliertriay/bricolage)",
            "files": "fonts/bricolage-grotesque-latin-standard-normal.woff2",
            "weight": "200 800",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/inter 5.3.0 (rsms/inter)",
            "files": "fonts/inter-latin-wght-normal.woff2",
            "weight": "100 900",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 650
      },
      "heavy": {
        "$value": 800
      }
    }
  },
  "type": {
    "$type": "typography",
