{
  "$extensions": {
    "com.hummlist": {
      "contrastPairs": [
        [
          "on-mint",
          "mint",
          4.5
        ],
        [
          "text",
          "mint-soft",
          4.5
        ],
        [
          "on-cobalt",
          "cobalt",
          4.5
        ]
      ]
    }
