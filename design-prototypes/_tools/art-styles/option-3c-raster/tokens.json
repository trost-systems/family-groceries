      "on-accent": {
        "$value": "#0c0c0b"
      },
      "accent-soft": {
        "$value": "#24231f"
      },
      "surface": {
        "$value": "#0c0c0b"
      },
      "surface-raised": {
        "$value": "#171715"
      },
      "surface-sunken": {
        "$value": "#050505"
      },
      "text": {
        "$value": "#f4f2ec"
      },
      "text-muted": {
        "$value": "#aaa79e"
      },
      "border": {
        "$value": "#8b887f"
      },
      "divider": {
        "$value": "#2c2b27"
      },
      "ink": {
        "$value": "#000000"
      },
      "success": {
        "$value": "#7fd98a"
      },
      "on-success": {
        "$value": "#0c0c0b"
      },
      "success-soft": {
        "$value": "#1b3522"
