  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 7.5,
          "unit": "rem"
        },
        "fontWeight": 800,
        "lineHeight": 0.9,
        "letterSpacing": {
          "value": -0.045,
          "unit": "em"
        }
      },
      "$description": "Hero headline at 1440 px; the page scales it with clamp(3rem, 8.4vw, 7.5rem)"
    },
    "headline-l": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 4.5,
          "unit": "rem"
        },
        "fontWeight": 800,
        "lineHeight": 0.95,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 700,
        "lineHeight": 1.0,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 650,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "body-l": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.45,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 1.0625,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.25,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      },
      "$description": "Uppercase category dividers, overlines and section numbers' labels"
    }
  },
  "radius": {
    "$type": "dimension",
    "s": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "m": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "l": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "$value": {
        "value": 1,
        "unit": "px"
      },
      "$description": "Haarlinie: Konturen, Regeln, Rahmen"
    },
    "width-thin": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sticker-s": {
      "$value": [
        {
          "color": "#0b0b0b",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Rule: a 1 px ink line under a block"
    },
    "sticker": {
      "$value": [
        {
          "color": "#0b0b0b",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Edge: the 4 px ink base, same as a button's"
    },
    "sticker-l": {
      "$value": [
        {
          "color": "#ffc72c",
          "offsetX": {
            "value": 12,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Field: a flat honey block offset behind an object"
    },
    "night-s": {
      "$value": [
        {
          "color": "#8b887f",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "night": {
      "$value": [
        {
          "color": "#000000",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "night-l": {
      "$value": [
        {
          "color": "#ffc72c",
          "offsetX": {
            "value": 12,
            "unit": "px"
          },
          "offsetY": {
            "value": 12,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    }
  },
  "depth": {
    "$type": "dimension",
    "edge": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "Flat 4 px ink edge under a resting button"
    },
    "edge-l": {
      "$value": {
        "value": 5,
        "unit": "px"
      },
      "$description": "Edge of store badges"
    },
    "lift": {
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$description": "Extra rise on hover"
    },
    "press": {
      "$value": "{depth.edge}",
      "$description": "How far the face sinks on press: all the way into its edge"
    }
  },
  "$extensions": {
    "com.hummlist": {
      "contrastPairs": [
        [
          "surface",
          "text",
          4.5
        ],
        [
          "text-muted",
          "accent-soft",
          4.5
        ]
      ]
    }
  }
