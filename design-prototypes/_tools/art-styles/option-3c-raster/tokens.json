{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Inter Tight",
          "Inter",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/inter-tight 5.3.0 (rsms/inter-tight)",
            "files": "fonts/inter-tight-latin-wght-normal.woff2",
            "weight": "100 900",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/inter 5.3.0 (rsms/inter)",
            "files": "fonts/inter-latin-wght-normal.woff2",
            "weight": "100 900",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    }
  }
}