{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Inter Tight",
          "Inter",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/inter-tight 5.3.0 (rsms/inter-tight)",
            "files": "fonts/inter-tight-latin-wght-normal.woff2",
            "weight": "100 900",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/inter 5.3.0 (rsms/inter)",
            "files": "fonts/inter-latin-wght-normal.woff2",
            "weight": "100 900",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 650
      },
      "heavy": {
        "$value": 800
      }
    }
  },
  "color": {
    "light": {
      "$type": "color",
      "brand": {
        "$value": "#0b0b0b",
        "$description": "Tinte als Marke: Mengen, Listenkopf, Linien"
      },
      "on-brand": {
        "$value": "#ffffff"
      },
      "honey": {
        "$value": "#ffc72c",
        "$description": "Honig: die einzige Signalfarbe. Knöpfe, Zeichen, ein großes Feld"
      },
      "on-honey": {
        "$value": "#0b0b0b"
      },
      "honey-soft": {
        "$value": "#fff0c2",
        "$description": "Heller Honig: neue Einträge, aktive Chips"
      },
      "accent": {
        "$value": "#0b0b0b",
        "$description": "Links und Fokusring: Tinte, unterstrichen in Honig"
      },
      "on-accent": {
        "$value": "#ffffff"
      },
      "accent-soft": {
        "$value": "#e9e7e1",
        "$description": "Grau: Zitate und leise Flächen"
      },
      "surface": {
        "$value": "#f5f4ef",
        "$description": "Papier: leicht warmes Weiß"
      },
      "surface-raised": {
        "$value": "#ffffff",
        "$description": "Weiß: Telefon-Bildschirm, Eingabefeld"
      },
      "surface-sunken": {
        "$value": "#ebe9e2",
        "$description": "Mulden und Bildflächen"
      },
      "text": {
        "$value": "#0b0b0b",
        "$description": "Tinte: echtes Schwarz"
      },
      "text-muted": {
        "$value": "#55534d"
      },
      "border": {
        "$value": "#0b0b0b",
        "$description": "Haarlinie in Tinte, 1 px"
      },
      "divider": {
        "$value": "#d3d0c7",
        "$description": "Rasterlinien und Trennlinien (dekorativ)"
      },
      "ink": {
        "$value": "#0b0b0b"
      },
      "success": {
        "$value": "#1f7a3a",
