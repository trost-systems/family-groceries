      },
      "on-success": {
        "$value": "#ffffff"
      },
      "success-soft": {
        "$value": "#d6ecd5"
      },
      "warning": {
        "$value": "#a34700"
      },
      "on-warning": {
        "$value": "#ffffff"
      },
      "error": {
        "$value": "#c0262d"
