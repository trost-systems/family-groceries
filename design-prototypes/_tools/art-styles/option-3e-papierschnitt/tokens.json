{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Fraunces",
          "Georgia",
          "serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/fraunces 5.3.0 (undercasetype/Fraunces)",
            "files": "fonts/fraunces-latin-full-normal.woff2",
            "weight": "100 900",
            "role": "Überschriften, Zahlen, Ladennamen"
          }
        }
      },
      "sans": {
        "$value": [
          "Figtree",
          "system-ui",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$extensions": {
          "com.hummlist": {
            "license": "OFL-1.1",
            "source": "@fontsource-variable/figtree 5.3.0 (erikdkennedy/figtree)",
            "files": "fonts/figtree-latin-wght-normal.woff2",
            "weight": "300 900",
            "role": "Alles andere: Fließtext, Artikel, Knöpfe"
          }
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 550
      },
      "bold": {
        "$value": 650
      },
      "heavy": {
        "$value": 750
      }
    }
  },
  "$extensions": {
    "com.hummlist": {
      "contrastPairs": [
        [
          "text-muted",
          "honey-soft",
          4.5
        ],
        [
          "text",
          "surface-edge",
          4.5
        ]
      ]
    }
  },
  "color": {
    "light": {
      "$type": "color",
      "brand": {
        "$value": "#87560f",
        "$description": "Honigbraun: Honig als Schrift, Linie und Menge („2×“) auf hellem Papier"
      },
      "on-brand": {
        "$value": "#ffffff"
      },
      "honey": {
        "$value": "#f4b942",
        "$description": "Honigkarton: die Markenlage, immer mit Tintenbraun darauf"
      },
      "on-honey": {
        "$value": "#3a2a1d"
      },
      "honey-soft": {
        "$value": "#fbe1a6",
        "$description": "Pollenpapier: leise Lage für Chips und neue Einträge"
      },
      "accent": {
        "$value": "#6a3f96",
        "$description": "Pflaume: Links, Stimme und Fokusring"
      },
      "on-accent": {
        "$value": "#ffffff"
      },
      "accent-soft": {
        "$value": "#e6dcf2",
        "$description": "Lavendelpapier: Sprechblasen, Stimme"
      },
      "surface": {
        "$value": "#f5ecda",
        "$description": "Cremekarton: der Seitengrund, mit Faserstruktur"
      },
      "surface-raised": {
        "$value": "#fffaf0",
        "$description": "Helles Papier: Karten und Sticker, eine Lage höher"
      },
      "surface-sunken": {
        "$value": "#ecdcbd",
        "$description": "Ausschnitt: Fenster in der Lage, Fußzeile"
      },
      "text": {
        "$value": "#3a2a1d",
        "$description": "Tintenbraun: warmer Text statt Schwarz"
      },
      "text-muted": {
        "$value": "#6a5442"
      },
      "border": {
        "$value": "#7a6049",
        "$description": "Schnittkante: Linien an Kästchen und Feldern (3 : 1)"
      },
      "divider": {
        "$value": "#e2d2b4",
        "$description": "Falzlinie zwischen Zeilen (dekorativ)"
      },
      "ink": {
        "$value": "#3a2a1d",
        "$description": "Schattenfarbe, mit Deckkraft gemischt"
      },
      "success": {
        "$value": "#3d6b35",
        "$description": "Blattgrün: abgehakt und synchron"
      },
      "on-success": {
        "$value": "#ffffff"
      },
      "success-soft": {
        "$value": "#d6e6c6"
      },
      "warning": {
        "$value": "#9c4a12"
      },
      "on-warning": {
        "$value": "#ffffff"
      },
      "error": {
        "$value": "#b3322f"
      },
      "on-error": {
        "$value": "#ffffff"
      },
      "edge": {
        "$value": "#d48a63",
        "$description": "Schnittkante der unteren Lage unter Knöpfen"
      },
      "honey-edge": {
        "$value": "#f2a77f",
        "$description": "Untere Lage unter Honigknöpfen: Aprikose"
      },
      "surface-edge": {
        "$value": "#e3cfa8",
        "$description": "Untere Lage unter hellen Knöpfen: Packpapier"
      },
      "apricot": {
        "$value": "#f2a77f",
        "$description": "Aprikose: zweite Lage im Zeichen und in der Landschaft"
      },
      "sage": {
        "$value": "#a9c49a",
        "$description": "Salbei: dritte Lage, Hügel, abgehakte Waben"
      },
      "lavender": {
        "$value": "#c9b8e6",
        "$description": "Lavendel: hinterste Lage, Himmel der Landschaft"
      }
    },
    "dark": {
