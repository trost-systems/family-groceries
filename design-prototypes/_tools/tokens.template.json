{
  "$description": "Hummlist design tokens, option 1 (template). DTCG 2025.10 format. Colours per mode under color.light and color.dark with identical keys.",
  "$extensions": {
    "com.hummlist": {
      "option": "option-1-template",
      "contrastPairs": [["on-brand-container", "brand-container", 4.5]]
    }
  },
  "color": {
    "light": {
      "$type": "color",
      "brand": { "$value": { "colorSpace": "srgb", "components": [0.2353, 0.4118, 0.2235], "hex": "#3c6939" }, "$description": "M3 primary from seed #2E7D32" },
      "on-brand": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "brand-container": { "$value": { "colorSpace": "srgb", "components": [0.7373, 0.9412, 0.7059], "hex": "#bcf0b4" } },
      "on-brand-container": { "$value": { "colorSpace": "srgb", "components": [0.1412, 0.3137, 0.1412], "hex": "#245024" } },
      "accent": { "$value": { "colorSpace": "srgb", "components": [0.2196, 0.3961, 0.4157], "hex": "#38656a" } },
      "on-accent": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.9843, 0.9451], "hex": "#f7fbf1" } },
      "surface-raised": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "text": { "$value": { "colorSpace": "srgb", "components": [0.098, 0.1137, 0.0902], "hex": "#191d17" } },
      "text-muted": { "$value": { "colorSpace": "srgb", "components": [0.2588, 0.2863, 0.251], "hex": "#424940" } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.7608, 0.7882, 0.7412], "hex": "#c2c9bd" } },
      "success": { "$value": { "colorSpace": "srgb", "components": [0.1804, 0.4902, 0.1961], "hex": "#2e7d32" } },
      "on-success": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "warning": { "$value": { "colorSpace": "srgb", "components": [0.4784, 0.349, 0], "hex": "#7a5900" } },
      "on-warning": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "error": { "$value": { "colorSpace": "srgb", "components": [0.7294, 0.102, 0.102], "hex": "#ba1a1a" } },
      "on-error": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } }
    },
    "dark": {
      "$type": "color",
      "brand": { "$value": { "colorSpace": "srgb", "components": [0.6314, 0.8275, 0.6039], "hex": "#a1d39a" } },
      "on-brand": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.2235, 0.0588], "hex": "#0a390f" } },
      "brand-container": { "$value": { "colorSpace": "srgb", "components": [0.1412, 0.3137, 0.1412], "hex": "#245024" } },
      "on-brand-container": { "$value": { "colorSpace": "srgb", "components": [0.7373, 0.9412, 0.7059], "hex": "#bcf0b4" } },
      "accent": { "$value": { "colorSpace": "srgb", "components": [0.6275, 0.8118, 0.8314], "hex": "#a0cfd4" } },
      "on-accent": { "$value": { "colorSpace": "srgb", "components": [0, 0.2118, 0.2314], "hex": "#00363b" } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.0627, 0.0784, 0.0588], "hex": "#10140f" } },
      "surface-raised": { "$value": { "colorSpace": "srgb", "components": [0.1137, 0.1294, 0.1059], "hex": "#1d211b" } },
      "text": { "$value": { "colorSpace": "srgb", "components": [0.8784, 0.8941, 0.8588], "hex": "#e0e4db" } },
      "text-muted": { "$value": { "colorSpace": "srgb", "components": [0.7608, 0.7882, 0.7412], "hex": "#c2c9bd" } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.2588, 0.2863, 0.251], "hex": "#424940" } },
      "success": { "$value": { "colorSpace": "srgb", "components": [0.6314, 0.8275, 0.6039], "hex": "#a1d39a" } },
      "on-success": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.2235, 0.0588], "hex": "#0a390f" } },
      "warning": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.749, 0.3412], "hex": "#f5bf57" } },
      "on-warning": { "$value": { "colorSpace": "srgb", "components": [0.2549, 0.1765, 0], "hex": "#412d00" } },
      "error": { "$value": { "colorSpace": "srgb", "components": [1, 0.7059, 0.6706], "hex": "#ffb4ab" } },
      "on-error": { "$value": { "colorSpace": "srgb", "components": [0.4118, 0, 0.0196], "hex": "#690005" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Roboto Flex", "Roboto", "system-ui", "sans-serif"],
        "$extensions": { "com.hummlist": { "license": "OFL-1.1", "source": "@fontsource-variable/roboto-flex 5.3.0 (google/fonts)", "files": "fonts/roboto-flex-latin-wght-normal.woff2" } }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    }
  },
  "type": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 2.75, "unit": "rem" }, "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": { "value": -0.02, "unit": "em" } } },
    "headline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 1.75, "unit": "rem" }, "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": { "value": -0.01, "unit": "em" } } },
    "title": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 1.25, "unit": "rem" }, "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": { "value": 0, "unit": "em" } } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 1.0625, "unit": "rem" }, "fontWeight": 400, "lineHeight": 1.55, "letterSpacing": { "value": 0, "unit": "em" } } },
    "label": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 0.875, "unit": "rem" }, "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": { "value": 0.01, "unit": "em" } } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 24, "unit": "px" } },
    "6": { "$value": { "value": 32, "unit": "px" } },
    "7": { "$value": { "value": 48, "unit": "px" } },
    "8": { "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": { "value": 8, "unit": "px" } },
    "m": { "$value": { "value": 12, "unit": "px" } },
    "l": { "$value": { "value": 28, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "1": { "$value": [{ "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12, "hex": "#000000" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }] },
    "3": { "$value": [
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12, "hex": "#000000" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": 3, "unit": "px" } },
      { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.2, "hex": "#000000" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 3, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ] }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "short": { "$value": { "value": 120, "unit": "ms" } },
      "medium": { "$value": { "value": 220, "unit": "ms" } },
      "long": { "$value": { "value": 280, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized-decelerate": { "$value": [0.05, 0.7, 0.1, 1] },
      "emphasized-accelerate": { "$value": [0.3, 0, 0.8, 0.15] }
    }
  }
}
