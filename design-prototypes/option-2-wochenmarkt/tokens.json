          "text-muted",
          "surface-sunken",
          4.5
        ],
        [
          "on-brand-container",
          "brand-container",
          4.5
        ],
        [
          "on-highlight",
          "highlight",
          4.5
        ],
        [
          "on-kraft",
          "kraft",
          4.5
        ],
        [
          "on-chalk",
          "chalk",
          4.5
        ],
        [
          "highlight",
          "chalk",
          3
        ],
        [
          "border-strong",
          "surface",
          3
        ],
        [
          "border-strong",
          "surface-raised",
          3
