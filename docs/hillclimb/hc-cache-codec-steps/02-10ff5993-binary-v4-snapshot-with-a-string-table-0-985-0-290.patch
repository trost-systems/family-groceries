diff --git a/app/lib/list/snapshot_codec.dart b/app/lib/list/snapshot_codec.dart
new file mode 100644
index 00000000..1916ac0c
--- /dev/null
+++ b/app/lib/list/snapshot_codec.dart
@@ -0,0 +1,500 @@
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:family_groceries/list/list_cache.dart';
+import 'package:family_groceries/list/model.dart';
+
+/// How a [ListSnapshot] is kept on the device: a String, since shared
+/// preferences store strings. [encodeSnapshot] writes [_prefix] and the
+/// base64 of a binary layout with one table of the snapshot's distinct
+/// strings; [decodeSnapshot] also reads the JSON snapshots apps before it
+/// wrote (versions 1 to 3, `{...}`). Throws on anything else.
+String encodeSnapshot(ListSnapshot snapshot) {
+  final body = _Writer();
+  body
+    ..catalog(snapshot.catalog)
+    ..list(snapshot.server, body.item)
+    ..list(snapshot.pending, body.op)
+    ..list(snapshot.usuals, body.usual);
+  final out = _Writer()
+    ..uint(_binaryVersion)
+    ..uint(body.strings.length);
+  body.strings.keys.forEach(out.utf8String);
+  out.bytes(body.takeBytes());
+  return '$_prefix${base64.encode(out.takeBytes())}';
+}
+
+ListSnapshot decodeSnapshot(String stored) {
+  if (stored.startsWith('{')) {
+    return ListSnapshot.fromJson(jsonDecode(stored) as Map<String, Object?>);
+  }
+  if (!stored.startsWith(_prefix)) {
+    throw const FormatException('list snapshot');
+  }
+  final r = _Reader(base64.decode(stored.substring(_prefix.length)));
+  final version = r.uint();
+  if (version != _binaryVersion) {
+    throw FormatException('snapshot version', version);
+  }
+  r.readStrings();
+  return ListSnapshot(
+    catalog: r.catalog(),
+    server: r.list(r.item),
+    pending: r.list(r.op),
+    usuals: r.list(r.usual),
+  );
+}
+
+const _prefix = 'b4:';
+
+/// [ListSnapshot.version] 3 is the JSON layout; 4 is this one.
+const _binaryVersion = 4;
+
+const _timeNull = 0;
+const _timeUtc = 1;
+
+/// A local time keeps its wall-clock text, as JSON snapshots did.
+const _timeLocal = 2;
+
+const _sortKeyNull = 0;
+const _sortKeyHalves = 1;
+const _sortKeyDouble = 2;
+
+/// Half steps of [_sortKeyHalves] stay exact up to here.
+const _maxHalves = 1 << 52;
+
+enum _Op() {
+  add,
+  status,
+  edit,
+  move,
+  place,
+  delete,
+  merge,
+  unmerge,
+}
+
+class _Writer() {
+  var _buf = Uint8List(1 << 16);
+  var _len = 0;
+
+  /// Insertion order is the table order.
+  final strings = <String, int>{};
+
+  final _scratch = ByteData(8);
+
+  void _ensure(int extra) {
+    if (_len + extra > _buf.length) {
+      var size = _buf.length * 2;
+      while (size < _len + extra) {
+        size *= 2;
+      }
+      _buf = Uint8List(size)..setRange(0, _len, _buf);
+    }
+  }
+
+  Uint8List takeBytes() => Uint8List.sublistView(_buf, 0, _len);
+
+  void byte(int b) {
+    _ensure(1);
+    _buf[_len++] = b;
+  }
+
+  void bytes(Uint8List b) {
+    _ensure(b.length);
+    _buf.setRange(_len, _len + b.length, b);
+    _len += b.length;
+  }
+
+  void uint(int v) {
+    _ensure(10);
+    var x = v;
+    while (x >= 0x80) {
+      _buf[_len++] = (x & 0x7f) | 0x80;
+      x >>= 7;
+    }
+    _buf[_len++] = x;
+  }
+
+  void sint(int v) => uint(v >= 0 ? v << 1 : ((-v) << 1) - 1);
+
+  void boolean({required bool value}) => byte(value ? 1 : 0);
+
+  void utf8String(String s) {
+    final b = utf8.encode(s);
+    uint(b.length);
+    bytes(b);
+  }
+
+  void string(String s) => uint(strings.putIfAbsent(s, () => strings.length));
+
+  void optString(String? s) =>
+      uint(s == null ? 0 : strings.putIfAbsent(s, () => strings.length) + 1);
+
+  void time(DateTime? t) {
+    if (t == null) {
+      byte(_timeNull);
+    } else if (t.isUtc) {
+      byte(_timeUtc);
+      sint(t.microsecondsSinceEpoch);
+    } else {
+      byte(_timeLocal);
+      string(t.toIso8601String());
+    }
+  }
+
+  void sortKey(double? k) {
+    if (k == null) {
+      byte(_sortKeyNull);
+      return;
+    }
+    final halves = k * 2;
+    if (halves == halves.truncateToDouble() &&
+        halves.abs() < _maxHalves &&
+        !(k == 0 && k.isNegative)) {
+      byte(_sortKeyHalves);
+      sint(halves.toInt());
+    } else {
+      byte(_sortKeyDouble);
+      _scratch.setFloat64(0, k, Endian.little);
+      bytes(_scratch.buffer.asUint8List());
+    }
+  }
+
+  void list<T>(List<T> xs, void Function(T) write) {
+    uint(xs.length);
+    xs.forEach(write);
+  }
+
+  void catalog(Catalog c) {
+    list(c.categories, (x) {
+      string(x.id);
+      string(x.name);
+      sint(x.sortOrder);
+      optString(x.seedKey);
+    });
+    list(c.stores, (x) {
+      string(x.id);
+      string(x.name);
+      sint(x.sortOrder);
+      optString(x.seedKey);
+    });
+    list(c.layout, (x) {
+      string(x.storeId);
+      string(x.categoryId);
+      sint(x.sortOrder);
+      boolean(value: x.hidden);
+    });
+    list(c.members, (x) {
+      string(x.id);
+      string(x.displayName);
+      optString(x.role);
+    });
+  }
+
+  void item(Item i) {
+    string(i.id);
+    string(i.name);
+    optString(i.quantity);
+    optString(i.brand);
+    optString(i.properties);
+    optString(i.categoryId);
+    optString(i.storeId);
+    sortKey(i.sortKey);
+    byte(i.status.index);
+    time(i.createdAt);
+    time(i.updatedAt);
+    time(i.boughtAt);
+    optString(i.addedBy);
+    optString(i.categorizedVia);
+    optString(i.canonicalKey);
+  }
+
+  void change(SetTo<String?>? c) {
+    boolean(value: c != null);
+    if (c != null) {
+      optString(c.value);
+    }
+  }
+
+  void op(ItemOp op) {
+    switch (op) {
+      case AddItem(
+        item: final added,
+        :final restored,
+        :final noStore,
+        :final deviceParsed,
+      ):
+        byte(_Op.add.index);
+        item(added);
+        byte((restored ? 1 : 0) | (noStore ? 2 : 0) | (deviceParsed ? 4 : 0));
+      case SetStatus(:final itemId, :final status, :final at, :final storeId):
+        byte(_Op.status.index);
+        string(itemId);
+        byte(status.index);
+        time(at);
+        optString(storeId);
+      case EditItem(
+        :final itemId,
+        :final changes,
+        :final keyBefore,
+        :final deviceParsed,
+      ):
+        byte(_Op.edit.index);
+        string(itemId);
+        optString(changes.name);
+        change(changes.quantity);
+        change(changes.brand);
+        change(changes.properties);
+        optString(changes.categoryId);
+        change(changes.storeId);
+        optString(keyBefore);
+        boolean(value: deviceParsed);
+      case MoveItem(:final itemId, :final categoryId, :final storeId):
+        byte(_Op.move.index);
+        string(itemId);
+        string(categoryId);
+        optString(storeId);
+      case PlaceItem(
+        :final itemId,
+        :final anchorId,
+        :final edge,
+        :final categoryId,
+        :final storeId,
+        :final sortKey,
+      ):
+        byte(_Op.place.index);
+        string(itemId);
+        string(anchorId);
+        byte(edge.index);
+        string(categoryId);
+        optString(storeId);
+        this.sortKey(sortKey);
+      case DeleteItem(:final itemId):
+        byte(_Op.delete.index);
+        string(itemId);
+      case MergeItems(
+        :final itemId,
+        :final mergeId,
+        :final otherId,
+        :final quantity,
+        :final brand,
+        :final properties,
+      ):
+        byte(_Op.merge.index);
+        string(itemId);
+        string(mergeId);
+        string(otherId);
+        optString(quantity);
+        optString(brand);
+        optString(properties);
+      case UnmergeItems(
+        :final itemId,
+        :final mergeId,
+        :final kept,
+        :final merged,
+      ):
+        byte(_Op.unmerge.index);
+        string(itemId);
+        string(mergeId);
+        item(kept);
+        item(merged);
+    }
+  }
+
+  void usual(Usual u) {
+    string(u.name);
+    boolean(value: u.due);
+    optString(u.quantity);
+    time(u.lastUsed);
+  }
+}
+
+class _Reader(final Uint8List _b) {
+  var _pos = 0;
+  var _strings = const <String>[];
+
+  /// First: everything after refers to the table.
+  void readStrings() {
+    _strings = [for (var n = uint(); n > 0; n--) _utf8String()];
+  }
+
+  int byte() => _b[_pos++];
+
+  int uint() {
+    var result = 0;
+    var shift = 0;
+    while (true) {
+      final b = _b[_pos++];
+      result |= (b & 0x7f) << shift;
+      if (b < 0x80) {
+        return result;
+      }
+      shift += 7;
+    }
+  }
+
+  int sint() {
+    final v = uint();
+    return v.isEven ? v >> 1 : -((v + 1) >> 1);
+  }
+
+  bool boolean() => switch (byte()) {
+    0 => false,
+    1 => true,
+    final b => throw FormatException('bool', b),
+  };
+
+  String _utf8String() {
+    final n = uint();
+    final s = utf8.decode(Uint8List.sublistView(_b, _pos, _pos + n));
+    _pos += n;
+    return s;
+  }
+
+  String string() => _strings[uint()];
+
+  String? optString() => switch (uint()) {
+    0 => null,
+    final i => _strings[i - 1],
+  };
+
+  DateTime? time() => switch (byte()) {
+    _timeNull => null,
+    _timeUtc => DateTime.fromMicrosecondsSinceEpoch(sint(), isUtc: true),
+    _timeLocal => DateTime.parse(string()),
+    final tag => throw FormatException('time', tag),
+  };
+
+  double? sortKey() => switch (byte()) {
+    _sortKeyNull => null,
+    _sortKeyHalves => sint() / 2,
+    _sortKeyDouble => _float64(),
+    final tag => throw FormatException('sort key', tag),
+  };
+
+  double _float64() {
+    final v = ByteData.sublistView(
+      _b,
+      _pos,
+      _pos + 8,
+    ).getFloat64(0, Endian.little);
+    _pos += 8;
+    return v;
+  }
+
+  List<T> list<T>(T Function() read) => [
+    for (var n = uint(); n > 0; n--) read(),
+  ];
+
+  Catalog catalog() => Catalog(
+    categories: list(
+      () => Category(
+        id: string(),
+        name: string(),
+        sortOrder: sint(),
+        seedKey: optString(),
+      ),
+    ),
+    stores: list(
+      () => Store(
+        id: string(),
+        name: string(),
+        sortOrder: sint(),
+        seedKey: optString(),
+      ),
+    ),
+    layout: list(
+      () => StoreCategory(
+        storeId: string(),
+        categoryId: string(),
+        sortOrder: sint(),
+        hidden: boolean(),
+      ),
+    ),
+    members: list(
+      () => Member(id: string(), displayName: string(), role: optString()),
+    ),
+  );
+
+  Item item() => Item(
+    id: string(),
+    name: string(),
+    quantity: optString(),
+    brand: optString(),
+    properties: optString(),
+    categoryId: optString(),
+    storeId: optString(),
+    sortKey: sortKey(),
+    status: ItemStatus.values[byte()],
+    createdAt: time()!,
+    updatedAt: time()!,
+    boughtAt: time(),
+    addedBy: optString(),
+    categorizedVia: optString(),
+    canonicalKey: optString(),
+  );
+
+  SetTo<String?>? change() => boolean() ? SetTo(optString()) : null;
+
+  ItemOp op() => switch (_Op.values[byte()]) {
+    _Op.add => _add(item(), byte()),
+    _Op.status => SetStatus(
+      string(),
+      ItemStatus.values[byte()],
+      time()!,
+      storeId: optString(),
+    ),
+    _Op.edit => EditItem(
+      string(),
+      ItemChanges(
+        name: optString(),
+        quantity: change(),
+        brand: change(),
+        properties: change(),
+        categoryId: optString(),
+        storeId: change(),
+      ),
+      keyBefore: optString(),
+      deviceParsed: boolean(),
+    ),
+    _Op.move => MoveItem(string(), categoryId: string(), storeId: optString()),
+    _Op.place => PlaceItem(
+      string(),
+      anchorId: string(),
+      edge: Edge.values[byte()],
+      categoryId: string(),
+      storeId: optString(),
+      sortKey: sortKey(),
+    ),
+    _Op.delete => DeleteItem(string()),
+    _Op.merge => MergeItems(
+      string(),
+      mergeId: string(),
+      otherId: string(),
+      quantity: optString(),
+      brand: optString(),
+      properties: optString(),
+    ),
+    _Op.unmerge => UnmergeItems(
+      string(),
+      mergeId: string(),
+      kept: item(),
+      merged: item(),
+    ),
+  };
+
+  static AddItem _add(Item item, int flags) => AddItem(
+    item,
+    restored: flags & 1 != 0,
+    noStore: flags & 2 != 0,
+    deviceParsed: flags & 4 != 0,
+  );
+
+  Usual usual() => Usual(
+    name: string(),
+    due: boolean(),
+    quantity: optString(),
+    lastUsed: time(),
+  );
+}
