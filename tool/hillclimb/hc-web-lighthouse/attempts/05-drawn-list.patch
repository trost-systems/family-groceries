+/// What the list page draws from the [ListCubit]: the rows (server rows
+/// with pending ops on top), the catalog, the folded stores and which rows
+/// are new. Equal when a rebuild would draw the same, so the widgets that
+/// select it skip the usuals and the connection, which change while the
+/// list loads and reconnects; on the web each skipped rebuild is a frame
+/// of the whole list not drawn (job 129).
+@immutable
+class const DrawnList(final ListState state, final Set<String> fresh) {
+  factory of(ListCubit cubit) => DrawnList(cubit.state, cubit.fresh);
+
+  @override
+  bool operator ==(Object other) =>
+      other is DrawnList &&
+      other.state.loaded == state.loaded &&
+      identical(other.state.server, state.server) &&
+      identical(other.state.pending, state.pending) &&
+      identical(other.state.catalog, state.catalog) &&
+      identical(other.state.prefs, state.prefs) &&
+      setEquals(other.fresh, fresh);
+
+  @override
+  int get hashCode => Object.hash(
+    state.loaded,
+    state.server,
+    state.pending,
+    state.catalog,
+    state.prefs,
+    fresh.length,
+  );
+}
+
