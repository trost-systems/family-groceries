new file mode 100644
index 00000000..fa3c6be3
--- /dev/null
+++ a/app/lib/list/list_view/balanced_text.dart
@@ -0,0 +1,68 @@
+import 'package:flutter/material.dart';
+
+/// [Text] that wraps into lines of even length, like CSS's
+/// `text-wrap: balance`: a short hint that needs two lines sets as two
+/// phrases, not a full line and an orphaned word. Text that fits on one
+/// line is laid out as plain [Text].
+class const BalancedText(
+  final String data, {
+  final TextStyle? style,
+  final TextAlign? textAlign,
+  super.key,
+}) extends StatelessWidget {
+  @override
+  Widget build(BuildContext context) => LayoutBuilder(
+    builder: (context, constraints) {
+      final text = Text(data, style: style, textAlign: textAlign);
+      final width = _balancedWidth(context, constraints.maxWidth);
+      if (width == null) {
+        return text;
+      }
+      return Align(
+        alignment: textAlign == TextAlign.center
+            ? Alignment.topCenter
+            : AlignmentDirectional.topStart,
+        heightFactor: 1,
+        child: SizedBox(width: width, child: text),
+      );
+    },
+  );
+
+  /// The narrowest width that keeps the line count [data] has at [max];
+  /// null when it fits on one line.
+  double? _balancedWidth(BuildContext context, double max) {
+    if (!max.isFinite) {
+      return null;
+    }
+    final painter = TextPainter(
+      text: TextSpan(
+        text: data,
+        style: DefaultTextStyle.of(context).style.merge(style),
+      ),
+      textDirection: Directionality.of(context),
+      textScaler: MediaQuery.textScalerOf(context),
+      locale: Localizations.maybeLocaleOf(context),
+    );
+    int lines(double width) {
+      painter.layout(maxWidth: width);
+      return painter.computeLineMetrics().length;
+    }
+
+    final count = lines(max);
+    double? balanced;
+    if (count > 1) {
+      var (fits, breaks) = (max, 0.0);
+      while (fits - breaks > 1) {
+        final mid = (fits + breaks) / 2;
+        if (lines(mid) == count) {
+          fits = mid;
+        } else {
+          breaks = mid;
+        }
+      }
+      balanced = fits;
+    }
+    painter.dispose();
+    return balanced;
+  }
+}
