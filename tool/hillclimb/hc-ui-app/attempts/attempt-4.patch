+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// A row of a [NavCard]: its [icon] in a pointy hex, the [title], an
+/// optional [subtitle] and the [trailing] glyph. Every row's hex has the one
+/// cobalt-mist face, so no row looks highlighted.
+class const NavRow({
+  required final IconData icon,
+  required final Widget title,
+  required final VoidCallback onTap,
+  final Widget? subtitle,
+  final Widget? trailing,
+
+  /// The icon's colour; the text colour when null.
+  final Color? iconColor,
+
+  /// The hex's face; the rows' shared [HummlistColors.accentSoft] when null.
+  /// Sign-out passes the sunken surface: it is no page to open.
+  final Color? face,
+  final bool selected = false,
+  super.key,
+}) extends StatelessWidget {
+  @override
+  Widget build(BuildContext context) {
+    final t = HummlistColors.of(Theme.of(context).brightness);
+    return ListTile(
+      minTileHeight: 52,
+      contentPadding: const EdgeInsets.symmetric(horizontal: HlSpace.s3),
+      leading: PointyHex(
+        face: face ?? t.accentSoft,
+        // The visible contour in dark too, where the edge melts into the card.
+        contour: t.border,
+        size: 34,
+        child: Icon(icon, size: 18, color: iconColor ?? t.text),
+      ),
+      title: title,
+      subtitle: subtitle,
+      trailing: trailing,
+      selected: selected,
+      onTap: onTap,
+    );
+  }
+}
