+        hex.pathFor(slot, outset: -HexSegmented._gap - HlBorder.width / 2),
+        Paint()
+          ..style = PaintingStyle.stroke
+          ..strokeWidth = HlBorder.width
+          ..color = contour,
+      );
+  }
+
+  @override
+  bool shouldRepaint(_Indicator oldDelegate) =>
+      oldDelegate.face != face || oldDelegate.contour != contour;
