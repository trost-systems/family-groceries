+type Box = { x: number; y: number; width: number; height: number };
+
+/**
+ * Wheels the page until the dragged handle sits above the floating action button and the bottom
+ * bar, and the target handle below the app bar. A drag that starts on a handle the FAB or the bar
+ * covers presses that instead and moves nothing (the 9th category row at 480x900 since job 102's
+ * taller rows); a pointer near the list's edges also auto-scrolls it under the drag.
+ */
+async function clearOfChrome(page: Page, handleName: string, ontoHandleName: string): Promise<[Box, Box]> {
+  const { width, height } = page.viewportSize()!;
+  const fab = page.getByRole('button', { name: /^(Kategorie|Laden) hinzufügen$/ });
+  const fabBox = (await fab.count()) > 0 ? await fab.first().boundingBox() : null;
+  const bottom = Math.min(height - 80, fabBox ? fabBox.y : height) - 24;
+  const top = 120;
+  await page.mouse.move(width / 2, top + 40);
+  let last: number | undefined;
+  for (let i = 0; i < 20; i++) {
+    const from = (await page.getByText(handleName, { exact: true }).boundingBox())!;
+    const to = (await page.getByText(ontoHandleName, { exact: true }).boundingBox())!;
+    const below = Math.max(from.y + from.height, to.y + to.height) - bottom;
+    const above = top - Math.min(from.y, to.y);
+    if (below <= 0 && above <= 0) return [from, to];
+    if (below > 0 && above > 0) throw new Error(`${handleName} and ${ontoHandleName} do not fit between y ${top} and ${bottom}`);
+    if (last === from.y) throw new Error(`the page stopped scrolling with ${handleName} at y ${from.y} (clear between ${top} and ${bottom})`);
+    last = from.y;
+    await page.mouse.wheel(0, below > 0 ? below + 16 : -(above + 16));
+    await page.waitForTimeout(300);
