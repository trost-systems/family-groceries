{
  "$description": "Kassenzettel: the shopping list as a well-set receipt. Thermal-paper surfaces, black ink, one signal orange for brand and actions, the app's green only for success. JetBrains Mono for numbers, labels and the wordmark, IBM Plex Sans for reading. Square corners, hairline and dashed rules, hard offsets instead of soft shadows.",
  "$extensions": {
    "com.hummlist": {
      "option": "option-4-kassenzettel",
      "contrastPairs": [
        [
          "brand",
          "surface",
          4.5
        ],
        [
          "brand",
          "surface-raised",
          4.5
        ],
        [
          "text",
          "brand-wash",
          4.5
        ],
        [
          "text-muted",
          "brand-wash",
          4.5
        ],
        [
          "brand",
          "brand-wash",
          4.5
        ],
        [
          "success",
          "surface-raised",
          4.5
        ],
        [
          "error",
          "surface-raised",
          4.5
        ],
        [
          "border-strong",
          "surface",
          3
        ],
        [
          "border-strong",
          "surface-raised",
          3
        ],
        [
          "on-accent",
          "accent",
          4.5
        ],
        [
          "text",
          "surface-sunken",
          4.5
        ],
        [
          "text-muted",
          "surface-sunken",
          4.5
        ]
      ]
    }
  },
