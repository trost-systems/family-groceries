          "unit": "ms"
        }
      },
      "long": {
        "$value": {
          "value": 360,
          "unit": "ms"
        }
      },
      "press": {
        "$value": {
          "value": 70,
          "unit": "ms"
        },
        "$description": "Face sinking on press"
      },
      "release": {
        "$value": {
          "value": 160,
          "unit": "ms"
        },
        "$description": "Face returning after press or hover"
      }
    },
