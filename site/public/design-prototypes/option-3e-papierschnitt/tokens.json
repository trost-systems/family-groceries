    "hex": {
      "tip": {
        "$type": "number",
        "$value": 0.2887,
        "$description": "Width of each pointed end as a fraction of the control's height. 0.2887 = 1/(2·tan 60°): all six corners are 120°, the honeycomb angle."
      },
      "reference-height": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "Height at which corner-radius applies; the radius scales with the control's height"
      },
      "corner-radius": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Hex Soft: every corner rounded with this radius at reference-height (48 px), scaled with the control's height"
      }
