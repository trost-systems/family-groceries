#!/usr/bin/env bash
# Warns when a PR branch goes up as more than one commit: merging it then needs a squash and a
# second CI run. scripts/push-pr.sh pushes the one commit main takes. Never blocks a push.
# Installed by scripts/bootstrap.sh (core.hooksPath=.githooks, which every worktree shares).
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [[ $local_sha == "$zero" || $remote_ref != refs/heads/* || $remote_ref == refs/heads/main ]] && continue
  base="$(git rev-parse -q --verify refs/remotes/origin/main)" || continue
  count="$(git rev-list --count "$base..$local_sha")"
  if [[ $count -gt 1 ]]; then
    echo "pre-push: ${remote_ref#refs/heads/} is $count commits ahead of origin/main. Once its PR exists, push with scripts/push-pr.sh so the PR is the one commit merge-pr.sh merges after a single CI run." >&2
  fi
done
