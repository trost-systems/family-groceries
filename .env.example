# Copy to ~/groceries-ops/env (outside the repo) or export in your shell. Never commit real values.
# Personal access token for the Supabase CLI / Management API (https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=sbp_your_token_here
SUPABASE_PROJECT_REF=jdwqrallbpdbshrdhenk

# Sign in with Google and Apple (job 1b, docs/NEEDS_PETER.md section 4).
# Read by scripts/configure-social-auth.mjs and, for a local stack with a
# provider enabled, by supabase/config.toml.
GOOGLE_WEB_CLIENT_ID=1234567890-web.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your_google_web_client_secret
GOOGLE_IOS_CLIENT_ID=1234567890-ios.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=1234567890-android.apps.googleusercontent.com
APPLE_SERVICES_ID=com.petertrost.familygroceries.web
APPLE_TEAM_ID=YOURTEAMID
APPLE_KEY_ID=YOURKEYID
APPLE_PRIVATE_KEY_FILE=/path/outside/the/repo/AuthKey_YOURKEYID.p8
# Local stack only: config.toml's [auth.external.*] read these when enabled.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=web-client-id,ios-client-id,android-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_web_client_secret
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.petertrost.familygroceries.web,com.petertrost.familygroceries,com.hummlist.app
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=apple_client_secret_jwt

# The hummlist.com waitlist (job 82, docs/WAITLIST.md). Supabase function secrets for `waitlist`
# (supabase secrets set; supabase/functions/.env on a local stack); scripts/waitlist/invite.ts
# reads the same names from the shell with SUPABASE_DB_URL. The function answers 404 until both
# WAITLIST_ secrets are set.
WAITLIST_PROXY_SECRET=
WAITLIST_HMAC_SECRET=
RESEND_API_KEY=
# Optional: another Resend endpoint (tests). Default https://api.resend.com.
RESEND_API_URL=
# Unset: only hello+…@hummlist.com are stored and mailed. `*`: everyone.
WAITLIST_MAIL_ALLOW=
# 1: mails may still contain ⟦…⟧ draft markers (test addresses only).
WAITLIST_ALLOW_PLACEHOLDERS=
